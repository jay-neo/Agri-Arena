{
  "productName": "AgriArena",
  "version": "0.1.0",
  "identifier": "com.agri.arena",
  "build": {
    "frontendDist": "../../web/.next",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "cd ../web && npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AgriArena",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' http://localhost:3000"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    }
  },
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json"
}

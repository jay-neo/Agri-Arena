PROFILE=web
NEXT_PUBLIC_MYENV=development

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# For Database
DATABASE_URL="postgresql://<USERNAME>:<PASSWORD>@localhost:5432/<DATABASE_NAME>?schema=public"
SHADOW_DATABASE_URL="postgresql://<USERNAME>:<PASSWORD>@localhost:5432/<DB_NAME>?schema=public"


# AWS Configuration for storing images and avatars
AWS_S3_REGION=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_PUBLIC_BUCKET=


# For Chating with AI 
NEXT_PUBLIC_OPENAI_API_KEY=
NEXT_PUBLIC_GEMINI_API_KEY=


# For Auth.js
AUTH_SECRET=ANY_RANDOM_STRING
AUTH_TRUST_HOST=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=


# For AI Model
DD_MODEL_ENDPOINT=DD_MODEL_ENDPOINT
CP_MODEL_ENDPOINT=CP_MODEL_ENDPOINT

# Other Third Party Services
NEXT_PUBLIC_LINKPREVIEW_API_KEY=NEXT_PUBLIC_LINKPREVIEW_API_KEY
NEXT_PUBLIC_WEATHER_API_KEY=NEXT_PUBLIC_WEATHER_API_KEY
NEWS_API_KEY=NEWS_API_KEY